# 复制为 .env。SECRET_KEY 由“flask --app app init-db”自动生成，无需填写密码。
SITE_NAME=西校区失物招领
SCHOOL_NAME=保定职业技术学院（西校区）
# 默认 SQLite；PythonAnywhere 免费新账号可用。
# 开通 MySQL 后填写连接串；密码含特殊字符需 URL 编码，详见说明。
# DATABASE_URL=mysql+pymysql://用户名:密码@数据库主机/数据库名称?charset=utf8mb4
# 公网 HTTPS 上线时设为 1，本地 HTTP 保持 0。
COOKIE_SECURE=0
# PythonAnywhere 上设为实际主机名，不带 https://，例如 用户名.pythonanywhere.com
# ALLOWED_HOSTS=用户名.pythonanywhere.com
# 仅用于本地展示，正式网站保持 0。
DEMO_MODE=0
# 默认最多保存 120 MiB 图片，给数据库和依赖预留空间。
UPLOAD_BUDGET_MB=120
